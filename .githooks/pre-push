#!/bin/sh
# Local guard: main is merged through pull requests, never pushed directly.
# This is not server-side enforcement; GitHub branch protection needs a public
# repository or a paid plan. Bypass is possible with: git push --no-verify
zero=0000000000000000000000000000000000000000
blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
	[ "$remote_ref" = "refs/heads/main" ] || continue
	if [ "$local_sha" = "$zero" ]; then
		echo "pre-push: refusing to delete refs/heads/main" >&2
	else
		echo "pre-push: direct push to main is blocked; open a pull request from ${local_ref#refs/heads/}" >&2
	fi
	echo "pre-push: emergency bypass (not recommended): git push --no-verify" >&2
	blocked=1
done
exit "$blocked"
