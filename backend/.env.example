# Copy to .env; this file contains examples only. Never commit real secrets.
# 本地后端监听地址，0.0.0.0 也允许同一局域网手机连接；不是对外域名。
COST_ADDR=0.0.0.0:8080
COST_ENV=development
COST_STORE=mysql
COST_AUTH_MODE=wechat
COST_MYSQL_DSN='cost:cost_local_password@tcp(127.0.0.1:3306)/cost?parseTime=true&charset=utf8mb4&loc=UTC'
# Must match miniprogram/project.config.json. Get credentials in WeChat console.
# Required when COST_AUTH_MODE=wechat: empty values make the server refuse to start.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Only used if COST_AUTH_MODE=development (local backend tests without WeChat).
COST_DEV_TOKEN=cost-local-dev

# Optional reference cache. Leave BOTH blank to disable. Never commit a real password.
# Production internal address: cost-redis:6379 (existing private Redis container).
COST_REDIS_ADDR=
COST_REDIS_PASSWORD=
