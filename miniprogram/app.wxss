page{background:#F4F5F7;color:#1A1D21;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:28rpx}
.container{padding:32rpx 28rpx 160rpx}.title{font-size:54rpx;font-weight:800;margin:18rpx 0 32rpx}.card{background:#fff;border-radius:24rpx;padding:32rpx;margin-bottom:24rpx}.muted{color:#8B9199;font-size:25rpx}.expense{color:#E5484D}.income{color:#17A34A}.row{display:flex;align-items:center;justify-content:space-between}.amount{font-size:54rpx;font-weight:700;margin:24rpx 0}.section{font-size:32rpx;font-weight:650;margin:20rpx 0}.empty{text-align:center;color:#8B9199;padding:64rpx 20rpx}.button{background:#3B82F6;color:#fff;border-radius:22rpx;font-size:30rpx}.error{background:#FDECEC;color:#E5484D;border-radius:18rpx;padding:24rpx;margin:20rpx 0;font-size:25rpx}.field{padding:24rpx 0;border-bottom:1rpx solid #ECEEF1}.label{font-size:25rpx;color:#8B9199;margin-bottom:14rpx}input{height:60rpx}button::after{border:0}
