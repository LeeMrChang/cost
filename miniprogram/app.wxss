page{background:#f5f5f7;color:#25252b;font-family:-apple-system,BlinkMacSystemFont,sans-serif;font-size:28rpx}
.container{padding:32rpx 28rpx 160rpx}.title{font-size:54rpx;font-weight:800;margin:18rpx 0 32rpx}.card{background:#fff;border-radius:30rpx;padding:32rpx;margin-bottom:24rpx}.muted{color:#96969e;font-size:25rpx}.expense{color:#f3695c}.income{color:#31bf73}.row{display:flex;align-items:center;justify-content:space-between}.amount{font-size:54rpx;font-weight:700;margin:24rpx 0}.section{font-size:32rpx;font-weight:650;margin:20rpx 0}.empty{text-align:center;color:#96969e;padding:64rpx 20rpx}.button{background:#1687ff;color:#fff;border-radius:22rpx;font-size:30rpx}.error{background:#fff0eb;color:#bc4c3b;border-radius:18rpx;padding:24rpx;margin:20rpx 0;font-size:25rpx}.field{padding:24rpx 0;border-bottom:1rpx solid #eee}.label{font-size:25rpx;color:#96969e;margin-bottom:14rpx}input{height:60rpx}button::after{border:0}
