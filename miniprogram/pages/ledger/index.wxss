.day{margin:34rpx 0 16rpx;color:#96969e;font-size:25rpx}.entries{padding:0 28rpx}.entry{padding:28rpx 0;border-bottom:1rpx solid #f0f0f3;gap:16rpx}.entry:last-child{border:0}.icon{width:70rpx;height:70rpx;display:flex;align-items:center;justify-content:center;background:#fff0ed;border-radius:50%;margin-right:20rpx;font-size:36rpx}.entry-name{font-weight:650;margin-bottom:8rpx}.entry-amount{font-weight:700;font-size:32rpx;flex-shrink:0}.add{position:fixed;right:32rpx;bottom:48rpx;width:112rpx;height:112rpx;padding:0;border-radius:50%;background:#ffbe19;color:#fff;font-size:76rpx;line-height:100rpx;box-shadow:0 8rpx 28rpx #ffbe1955}.mask{position:fixed;inset:0;background:#0006;display:flex;align-items:flex-end;z-index:10}.sheet{width:100%;box-sizing:border-box;background:#f5f5f7;border-radius:34rpx 34rpx 0 0;padding:32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));max-height:88vh;overflow-y:auto}.switch{display:flex;background:#e8e8ed;border-radius:16rpx;padding:6rpx}.switch text{padding:10rpx 26rpx}.selected{background:white;border-radius:12rpx;font-weight:700}.category-grid{display:flex;flex-wrap:wrap;margin-top:28rpx}.category{width:25%;text-align:center;box-sizing:border-box;padding:14rpx 0;font-size:24rpx;border-radius:20rpx}.emoji{font-size:40rpx;margin-bottom:10rpx}.active{background:#fff0de}.money-input{font-size:60rpx;height:90rpx}.save{margin-top:30rpx;color:white}.save.expense{background:#f3695c}.save.income{background:#31bf73}.delete{color:#f3695c;background:transparent;margin-top:16rpx}
.month-chip{background:#fff;padding:16rpx 20rpx;border-radius:20rpx;font-size:25rpx;flex-shrink:0}.search-bar{display:flex;gap:20rpx;align-items:center;background:#fff;padding:14rpx 24rpx;border-radius:22rpx}.search-bar input{flex:1;min-width:0;font-size:26rpx}.search-bar text,.text-link{color:#1687ff;font-size:25rpx}.tools{margin:18rpx 0 24rpx}.tool{padding:15rpx 20rpx;border-radius:18rpx;background:#eaeaf0;font-size:25rpx}.tool.on{background:#e6f1ff;color:#1687ff}.export{background:transparent;margin:0;padding:0 12rpx;font-size:25rpx;color:#666674}.range-label{font-size:23rpx;color:#767681;margin-bottom:20rpx}.summary-card{background:linear-gradient(135deg,#fff,#fffaf1)}.summary-value{font-size:32rpx;font-weight:650;margin-top:10rpx}.align-right{text-align:right}.summary-note{font-size:21rpx;color:#a1a1ab;margin-top:26rpx}.entry-main{display:flex;align-items:center;min-width:0}.entry-copy{min-width:0}.entry-note{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;max-width:330rpx}.entry-meta{font-size:21rpx;color:#aaaab3;margin-top:8rpx}.icon{flex-shrink:0}.load-more{font-size:26rpx;color:#1687ff;background:#eaf3ff;border-radius:18rpx}.end-note{text-align:center;font-size:23rpx;color:#a5a5ae;margin:32rpx}.filter-grid{display:grid;grid-template-columns:1fr 1fr;gap:0 24rpx}.filter-grid picker{min-width:0;font-size:25rpx}.date-range{gap:16rpx;font-size:27rpx;margin:14rpx 0 22rpx}.amount-range{gap:20rpx}.amount-range input{width:42%;background:#fff;border-radius:14rpx;padding:0 16rpx;box-sizing:border-box}.apply{margin-top:30rpx}.text-link{padding:8rpx 0}.sheet picker.field{display:block}

