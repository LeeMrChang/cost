.day{margin:34rpx 0 16rpx;color:#96969e;font-size:25rpx}.entries{padding:0 28rpx}.entry{padding:28rpx 0;border-bottom:1rpx solid #f0f0f3;gap:16rpx}.entry:last-child{border:0}.icon{width:70rpx;height:70rpx;display:flex;align-items:center;justify-content:center;background:#fff0ed;border-radius:50%;margin-right:20rpx;font-size:36rpx}.entry-name{font-weight:650;margin-bottom:8rpx}.entry-amount{font-weight:700;font-size:32rpx;flex-shrink:0}.add{position:fixed;right:32rpx;bottom:48rpx;width:112rpx;height:112rpx;padding:0;border-radius:50%;background:#ffbe19;color:#fff;font-size:76rpx;line-height:100rpx;box-shadow:0 8rpx 28rpx #ffbe1955}.mask{position:fixed;inset:0;background:#0006;display:flex;align-items:flex-end;z-index:10}.sheet{width:100%;box-sizing:border-box;background:#f5f5f7;border-radius:34rpx 34rpx 0 0;padding:32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));max-height:88vh;overflow-y:auto}.switch{display:flex;background:#e8e8ed;border-radius:16rpx;padding:6rpx}.switch text{padding:10rpx 26rpx}.selected{background:white;border-radius:12rpx;font-weight:700}.category-grid{display:flex;flex-wrap:wrap;margin-top:28rpx}.category{width:25%;text-align:center;box-sizing:border-box;padding:14rpx 0;font-size:24rpx;border-radius:20rpx}.emoji{font-size:40rpx;margin-bottom:10rpx}.active{background:#fff0de}.money-input{font-size:60rpx;height:90rpx}.save{margin-top:30rpx;color:white}.save.expense{background:#f3695c}.save.income{background:#31bf73}.delete{color:#f3695c;background:transparent;margin-top:16rpx}
