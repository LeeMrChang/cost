.ledger-head{display:flex;align-items:center;gap:24rpx}
.ledger-icon{font-size:64rpx}
.ledger-name{font-size:34rpx;font-weight:700;margin-bottom:8rpx}
.ledger-info{flex:1;min-width:0;word-break:break-all}
.ledger-edit-link{color:#3B82F6;font-size:26rpx;white-space:nowrap}
.ledger-editor{margin-top:28rpx;padding-top:28rpx;border-top:1rpx solid #ECEEF1}
.ledger-icons{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-bottom:28rpx}
.ledger-icon-option{width:100%;margin:0;padding:10rpx;font-size:42rpx;line-height:1.6;background:#F4F5F7;border:2rpx solid transparent;border-radius:16rpx}
.ledger-icon-option.selected{border-color:#3B82F6;background:#EFF6FF}
.ledger-edit-actions{display:flex;gap:16rpx}.ledger-edit-actions button{flex:1;margin:0;font-size:28rpx}
.nickname-input{padding:20rpx;background:#f5f5f7;border-radius:12rpx;margin-bottom:24rpx}
.management-link{padding:26rpx 0;border-bottom:1rpx solid #f0f0f3;gap:20rpx}.management-link:last-child{border:0}.management-link .muted{margin-top:12rpx;font-size:23rpx}.management-link>text{font-size:42rpx;color:#b1b1bb}
