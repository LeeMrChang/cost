.range-bar{display:flex;align-items:center;justify-content:space-between;margin:24rpx 0}
.arrow{width:64rpx;height:64rpx;line-height:60rpx;text-align:center;font-size:48rpx;color:#3B82F6;font-weight:700;background:#fff;border-radius:50%;box-shadow:0 2rpx 8rpx rgba(26,29,33,0.06)}
.range-label{font-size:32rpx;font-weight:700;color:#1A1D21}
.remaining{font-size:52rpx;font-weight:800;color:#1A1D21;margin:12rpx 0 16rpx}
.remaining.over{color:#E5484D}
.track{height:14rpx;background:#ECEEF1;border-radius:8rpx;overflow:hidden;margin-bottom:14rpx}
.fill{height:100%;background:#3B82F6;border-radius:8rpx}
.fill.over{background:#E5484D}
.budget-hint{color:#3B82F6;font-size:30rpx;font-weight:600;padding:12rpx 0}
.hint{font-size:24rpx;margin-top:6rpx}
.budget-row{padding:20rpx 0;border-bottom:1rpx solid #ECEEF1}
.budget-row:last-child{border-bottom:none}
.budget-row.editing{border-bottom:none}
.cat-name{font-size:30rpx;font-weight:600}
.cat-amount{font-size:30rpx;font-weight:700;color:#1A1D21}
.cat-amount.muted{color:#8B9199;font-weight:400}
.editor input{border:2rpx solid #ECEEF1;border-radius:14rpx;padding:16rpx 20rpx;font-size:30rpx;margin-top:12rpx}
.actions{display:flex;gap:16rpx;margin-top:16rpx;align-items:center}
.actions button{margin:0;flex:1}

.fill.warn{background:#F5A524}.fill.over{background:#E5484D}.budget-row .track{margin-top:14rpx}
