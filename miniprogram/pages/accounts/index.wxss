@import "../../styles/manage.wxss";
.account-summary{background:linear-gradient(135deg,#fff,#f1f8ff)}.account-tools{gap:20rpx;margin:28rpx 0}.account-tools button{flex:1;font-size:27rpx;margin:0;padding:4rpx 12rpx;white-space:nowrap}.new-account{color:#1687ff;background:#e5f0ff;border-radius:22rpx}.account-row{padding:28rpx 0;border-bottom:1rpx solid #f0f0f4}.account-row:last-child{border:0}.account-balance{font-size:32rpx;font-weight:700;margin-left:12rpx;flex-shrink:0}.account-actions{display:flex;justify-content:flex-end;gap:30rpx;margin-top:18rpx;font-size:24rpx}.transfer-row{padding:30rpx 0;border-bottom:1rpx solid #f0f0f4}.transfer-row:last-child{border:0}.transfer-route{font-size:27rpx;font-weight:650;flex:1;min-width:0;word-break:break-all;padding-right:18rpx}.transfer-route text{color:#b2b2ba;margin:0 8rpx}.transfer-amount{font-size:31rpx;font-weight:700;color:#1687ff;flex-shrink:0}.transfer-note{font-size:25rpx;color:#777783;margin:16rpx 0;word-break:break-all}.transfer-row .muted{font-size:22rpx}.remove-link{color:#ee8277;font-size:23rpx;margin-left:20rpx;flex-shrink:0}
