<view class="container">
 <view class="title">家庭账户</view><view class="intro">钱从哪里来，花到哪里去。</view>
 <view wx:if="{{error}}" class="error" bindtap="load">{{error}}（点击重新加载）</view>
 <view class="card account-summary"><view class="row muted"><text>账户总余额</text><text>人民币 CNY</text></view><view class="amount">¥{{balance}}</view><view class="muted">包含停用账户 · 不包含未指定账户的历史账单</view></view>
 <view class="row account-tools"><button class="button" disabled="{{loading || saving || activeAccounts.length < 2}}" bindtap="openTransfer">⇄ 记一笔转账</button><button wx:if="{{user.role === 'admin'}}" class="new-account" disabled="{{loading || saving}}" bindtap="openAccount">＋ 添加账户</button></view>
 <view wx:if="{{loading}}" class="empty">正在读取账户…</view>
 <view wx:if="{{!loading}}" class="card list-card"><view wx:for="{{accounts}}" wx:key="id" class="account-row"><view class="row"><view class="list-main" data-id="{{item.id}}" bindtap="editAccount"><view class="item-icon">{{item.icon}}</view><view><view class="item-name">{{item.name}} <text wx:if="{{item.disabled}}" class="badge">已停用</text></view><view class="muted">{{item.typeLabel}} · 初始 ¥{{item.opening}}</view></view></view><view class="account-balance {{item.balance_cent < 0 ? 'expense' : ''}}">¥{{item.balance}}</view></view><view wx:if="{{user.role === 'admin'}}" class="account-actions"><text class="text-link" data-id="{{item.id}}" bindtap="editAccount">编辑账户</text><text class="{{item.disabled ? 'income' : 'muted'}}" data-id="{{item.id}}" bindtap="toggleAccount">{{item.disabled ? '启用' : '停用'}}</text></view></view><view wx:if="{{!accounts.length}}" class="empty">还没有账户<view>{{user.role === 'admin' ? '添加现金、微信或银行卡开始记录' : '请联系管理员添加账户'}}</view></view></view>
 <view class="footnote">初始余额 + 收入 − 支出 + 转入 − 转出 = 当前余额。账户由全家共享，允许负余额。转账不会计入收支或预算。</view>
 <view class="row subheading"><text>转账记录</text><text class="muted">{{total}} 笔</text></view>
 <view wx:if="{{!loading && !transfers.length}}" class="empty">还没有转账记录</view>
 <view wx:if="{{!loading}}" class="card list-card"><view wx:for="{{transfers}}" wx:key="id" class="transfer-row"><view class="row"><view class="transfer-route">{{item.fromName}} <text>→</text> {{item.toName}}</view><view class="transfer-amount">¥{{item.display}}</view></view><view class="transfer-note">{{item.note || '账户间转账'}}</view><view class="row"><view class="muted">{{item.date}} {{item.time}} · {{item.authorName}}</view><text wx:if="{{item.canDelete}}" class="remove-link" data-id="{{item.id}}" bindtap="removeTransfer">删除</text></view></view></view>
 <button wx:if="{{!loading && hasMore}}" class="load-more" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多转账</button><view wx:if="{{!loading && transfers.length && !hasMore}}" class="end-note">已显示全部转账</view>
</view>
<view wx:if="{{accountEditor}}" class="mask" bindtap="close"><view class="sheet" catchtap="noop"><view class="row"><text bindtap="close">取消</text><text class="section">{{editID ? '编辑' : '添加'}}账户</text><text class="sheet-symbol">{{types[typeIndex].icon}}</text></view><view class="field"><view class="label">账户名称</view><input value="{{name}}" maxlength="50" placeholder="例如：生活银行卡" data-field="name" bindinput="input"/></view><picker class="field" range="{{types}}" range-key="label" value="{{typeIndex}}" bindchange="typeChange"><view class="label">账户类型</view><view>{{types[typeIndex].label}} ⌄</view></picker><view class="field"><view class="label">初始余额（元，可输入负数）</view><input value="{{opening}}" maxlength="14" placeholder="0.00" data-field="opening" bindinput="input" class="money-input"/></view><view class="footnote">填写纳入此账本前的余额。修改初始余额会调整当前余额，不会新增收支记录，也不绑定某个生效日期。</view><button class="button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveAccount">保存账户</button></view></view>
<view wx:if="{{transferEditor}}" class="mask" bindtap="close"><view class="sheet" catchtap="noop"><view class="row"><text bindtap="close">取消</text><text class="section">账户转账</text><text class="sheet-symbol">⇄</text></view><picker class="field" range="{{activeAccounts}}" range-key="name" value="{{fromIndex}}" data-field="from" bindchange="transferAccountChange"><view class="label">转出账户</view><view>{{activeAccounts[fromIndex].name}} ⌄</view></picker><picker class="field" range="{{activeAccounts}}" range-key="name" value="{{toIndex}}" data-field="to" bindchange="transferAccountChange"><view class="label">转入账户</view><view>{{activeAccounts[toIndex].name}} ⌄</view></picker><view class="field"><view class="label">金额（元）</view><input type="digit" value="{{amount}}" placeholder="0.00" data-field="amount" bindinput="input" class="money-input"/></view><view class="field" bindtap="openDate">{{date}} {{time}} ⌄</view><view class="field"><input value="{{note}}" maxlength="500" placeholder="备注（选填）" data-field="note" bindinput="input"/></view><view class="footnote">仅记录资金在账户之间移动，不计入收入、支出和预算。</view><button class="button" loading="{{saving}}" disabled="{{saving}}" bindtap="saveTransfer">确认记录转账</button></view></view>
<calendar-popup mode="date" visible="{{dateOpen}}" date="{{date}}" time="{{time}}" bind:confirm="onDateConfirm" bind:cancel="closeDate" />
