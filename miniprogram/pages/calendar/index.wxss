.page{background:#F4F5F7;min-height:100vh;padding:24rpx 28rpx calc(60rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.cal-head{display:flex;align-items:center;justify-content:space-between;margin:4rpx 0 20rpx}
.cal-month{display:flex;align-items:center}
.arrow{font-size:48rpx;color:#3B82F6;padding:0 20rpx;line-height:1}
.arrow-off{color:#B6BBC2}
.cal-title{font-size:34rpx;font-weight:750;color:#1A1D21;padding:0 6rpx}
.cal-stats{font-size:26rpx;color:#3B82F6;padding:10rpx 24rpx;background:#fff;border-radius:999rpx}
.cal-sum{display:flex;justify-content:space-between;align-items:center;background:#fff;border-radius:20rpx;padding:20rpx 28rpx;margin-bottom:20rpx;font-size:24rpx;color:#8B9199}
.cal-card{background:#fff;border-radius:24rpx;padding:20rpx 12rpx;margin-bottom:24rpx}
.cal-week{display:flex}
.cal-wd{flex:1;text-align:center;font-size:22rpx;color:#B6BBC2;padding:10rpx 0}
.cal-grid{display:flex;flex-wrap:wrap}
.cell{width:14.28%;height:112rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;box-sizing:border-box;border-radius:14rpx}
.cell-empty{visibility:hidden}
.cell-day{font-size:26rpx;color:#1A1D21;line-height:1.2}
.cell-nums{display:flex;flex-direction:column;align-items:center;margin-top:2rpx}
.cell-expense{font-size:18rpx;color:#E5484D;line-height:1.25;max-width:88rpx;overflow:hidden;white-space:nowrap}
.cell-income{font-size:18rpx;color:#17A34A;line-height:1.25;max-width:88rpx;overflow:hidden;white-space:nowrap}
.cell-none{font-size:18rpx;color:#C5CAD1;line-height:1.25}
.cell-today{border:2rpx solid #3B82F6}
.cell-on{background:#E8F0FE}
.day-head{display:flex;justify-content:space-between;align-items:center;margin:20rpx 6rpx 14rpx;color:#8B9199;font-size:24rpx}
.day-head-right{display:flex;align-items:center;gap:12rpx}
.card{background:#fff;border-radius:24rpx;margin-bottom:20rpx}
.entries{padding:0 28rpx}
.entry{display:flex;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #ECEEF1}
.entry:last-child{border:0}
.icon{width:72rpx;height:72rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;margin-right:22rpx;font-size:36rpx;flex-shrink:0}
.icon.expense{background:#FDECEC}
.icon.income{background:#E9F7EE}
.entry-copy{flex:1;min-width:0}
.entry-name{font-weight:650;color:#1A1D21;margin-bottom:6rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.entry-time{color:#B6BBC2;font-size:22rpx}
.entry-amount{font-weight:700;font-size:32rpx;flex-shrink:0;margin-left:16rpx}
.entry-amount.expense{color:#E5484D}
.entry-amount.income{color:#17A34A}
.empty{text-align:center;color:#8B9199;padding:80rpx 20rpx}
.error{background:#FDECEC;color:#E5484D;border-radius:18rpx;padding:24rpx;margin:20rpx 0;font-size:25rpx}
