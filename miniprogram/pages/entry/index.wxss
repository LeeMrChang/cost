.page{height:100vh;box-sizing:border-box;display:flex;flex-direction:column;background:#F4F5F7;padding-bottom:env(safe-area-inset-bottom)}.head{display:flex;align-items:center;justify-content:space-between;gap:12rpx;padding:28rpx 24rpx 16rpx}.cancel{font-size:28rpx;flex-shrink:0}.book{font-size:25rpx;font-weight:700;color:#3B82F6;max-width:220rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.kind-switch{display:flex;background:#E6E7EA;padding:4rpx;border-radius:18rpx;flex-shrink:0}.kind{padding:10rpx 24rpx;font-size:26rpx;color:#8B9199;border-radius:14rpx}.kind.on{background:#1C1E22;color:#fff;font-weight:650}.category-area{flex:1;min-height:0;height:0}.grid{display:flex;flex-wrap:wrap;padding:8rpx 20rpx 24rpx}.cell{width:20%;text-align:center;padding:12rpx 0;box-sizing:border-box}.cell-icon{width:88rpx;height:88rpx;line-height:88rpx;margin:0 auto;background:#ECECED;border-radius:50%;font-size:40rpx}.cell-name{font-size:22rpx;color:#8B9199;margin-top:8rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.expense .cell-on .cell-icon{background:#E5484D}.income .cell-on .cell-icon{background:#17A34A}.cell-on .cell-name{font-weight:650;color:#1A1D21}.foot{flex-shrink:0}.chips{display:flex;gap:10rpx;padding:14rpx 22rpx;white-space:nowrap}.chip{background:#fff;border-radius:30rpx;padding:12rpx 15rpx;font-size:23rpx;color:#1A1D21;flex-shrink:0}.amount-card{background:#fff;border-radius:26rpx;margin:0 24rpx 14rpx;padding:16rpx 24rpx 4rpx}.amount{font-size:76rpx;font-weight:700;line-height:1.25;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#E5484D}.income .amount{color:#17A34A}.note-row{border-top:1rpx solid #ECEEF1;margin-top:8rpx;padding:18rpx 0;display:flex;align-items:center;gap:12rpx;font-size:23rpx;white-space:nowrap}.note-hint{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;color:#8B9199}.note{width:100%;font-size:27rpx;padding:16rpx 0;max-height:120rpx}.pad{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12rpx;margin:0 18rpx 10rpx;padding:12rpx;background:#F0F1F3;border-radius:26rpx}.key{height:92rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;background:#fff;color:#1A1D21;font-size:42rpx;margin:0;padding:0;line-height:1.2;box-shadow:0 1rpx 3rpx #0001}.opkey>view{flex:1;text-align:center;padding:26rpx 0;font-size:36rpx;color:#8B9199}.opkey>view+view{border-left:1rpx solid #F0F1F3}.key.again{font-size:24rpx;font-weight:650}.key.done{background:#E5484D;color:#fff;font-size:32rpx;font-weight:700}.income .key.done{background:#17A34A}.key.done[disabled]{opacity:.45;color:#fff}.edit-label{text-align:center;color:#8B9199;font-size:24rpx;padding:0 16rpx 8rpx}

.page.expense,.page.income{color:#1A1D21}
