<view class="container">
 <view class="title">Cost 记账</view>
 <view class="card">
  <view class="section">简单记账，为生活留痕</view>
  <view class="muted">微信登录用于识别你的账本账号，不获取手机号。账单数据仅属于你自己。</view>
  <button wx:if="{{!user}}" class="button" loading="{{busy}}" disabled="{{busy}}" bindtap="signIn">微信登录</button>
  <view wx:else>
   <view class="section">已登录 · 用户 {{user.id}}</view>
   <button bindtap="signOut" disabled="{{busy}}">退出登录</button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
 </view>
 <view wx:if="{{develop}}" class="card">
  <view class="section">开发环境连接</view><input value="{{baseURL}}" data-field="baseURL" bindinput="input" placeholder="http://电脑局域网IP:8080" />
  <button bindtap="saveURL" disabled="{{busy}}">保存调试地址</button>
 </view>
</view>
