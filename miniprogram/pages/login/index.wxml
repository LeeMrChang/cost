<view class="container">
 <view class="title">Cost 家庭账本</view>
 <view class="card">
  <view class="section">和家人一起记录生活</view>
  <view class="muted">微信登录用于识别你的账本账号，不获取手机号。只有加入家庭的成员可以查看账单。</view>
  <button wx:if="{{!user}}" class="button" loading="{{busy}}" disabled="{{busy}}" bindtap="signIn">微信登录</button>
  <view wx:else>
   <view class="section">已登录 · 成员 {{user.id}}</view>
   <view wx:if="{{!user.role}}">
    <view class="muted">向家庭管理员获取一次性邀请码。</view>
    <input value="{{invite}}" maxlength="64" data-field="invite" bindinput="input" placeholder="粘贴家庭邀请码" />
    <button class="button" loading="{{busy}}" disabled="{{busy}}" bindtap="join">加入家庭账本</button>
    <button bindtap="toggleSetup" disabled="{{busy}}">{{setup ? '收起初始化' : '首次使用：初始化家庭'}}</button>
    <view wx:if="{{setup}}"><input value="{{secret}}" password maxlength="256" data-field="secret" bindinput="input" placeholder="输入服务端初始化密钥" /><button class="button" loading="{{busy}}" disabled="{{busy}}" bindtap="bootstrap">成为家庭管理员</button></view>
   </view>
   <button bindtap="signOut" disabled="{{busy}}">退出登录</button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
 </view>
 <view wx:if="{{develop}}" class="card">
  <view class="section">开发环境连接</view><input value="{{baseURL}}" data-field="baseURL" bindinput="input" placeholder="http://电脑局域网IP:8080" />
  <button bindtap="saveURL" disabled="{{busy}}">保存调试地址</button>
 </view>
</view>
