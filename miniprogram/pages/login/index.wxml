<view class="container">
 <view class="title">Cost 记账</view>
 <view class="card">
  <view class="section">简单记账，为生活留痕</view>
  <view class="muted">微信登录用于识别你的账本账号，不获取手机号。昵称用于识别使用者，账单数据仅属于你自己。</view>
  <button wx:if="{{!user}}" class="button" loading="{{busy}}" disabled="{{busy}}" bindtap="signIn">微信登录</button>
  <form wx:else bindsubmit="signIn">
   <view class="nickname-label">补充昵称</view>
   <input type="nickname" name="nickname" value="{{nickname}}" maxlength="128" placeholder="点击选择微信昵称或填写昵称" disabled="{{busy}}" />
   <view class="muted nickname-hint">请填写昵称后继续，可使用微信昵称。</view>
   <button class="button" loading="{{busy}}" disabled="{{busy}}" form-type="submit">保存昵称并进入</button>
  </form>
  <view wx:if="{{user}}">
   <view class="muted">已登录 · {{user.nickname || '待补充昵称'}}</view>
   <button bindtap="signOut" disabled="{{busy}}">退出登录</button>
  </view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
 </view>
 <view wx:if="{{develop}}" class="card">
  <view class="section">开发环境连接</view><input value="{{baseURL}}" data-field="baseURL" bindinput="input" placeholder="http://电脑局域网IP:8080" />
  <button bindtap="saveURL" disabled="{{busy}}">保存调试地址</button>
 </view>
</view>
