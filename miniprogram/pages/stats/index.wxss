.page{background:#F4F5F7;min-height:100vh;padding:0 0 calc(180rpx + env(safe-area-inset-bottom));box-sizing:border-box}
.header{position:sticky;top:0;z-index:20;background:#F4F5F7;padding:0 28rpx 12rpx;box-sizing:border-box}
.nav{display:flex;align-items:center;justify-content:space-between;height:88rpx}
.nav-title{flex:1;min-width:0;font-size:34rpx;font-weight:750;color:#1A1D21}
.nav-budget{font-size:28rpx;color:#3B82F6;font-weight:600;padding-left:24rpx}
.content{padding:0 28rpx}
.segments{display:flex;background:#fff;border-radius:20rpx;padding:8rpx;margin:12rpx 0 24rpx;box-shadow:0 2rpx 8rpx rgba(26,29,33,0.04)}
.segment{flex:1;text-align:center;font-size:28rpx;color:#8B9199;padding:16rpx 0;border-radius:14rpx}
.segment.on{background:#3B82F6;color:#fff;font-weight:600}
.range-bar{display:flex;align-items:center;justify-content:space-between;margin:8rpx 0 24rpx}
.arrow{width:64rpx;height:64rpx;line-height:60rpx;text-align:center;font-size:48rpx;color:#3B82F6;font-weight:700;background:#fff;border-radius:50%;box-shadow:0 2rpx 8rpx rgba(26,29,33,0.06)}
.arrow.off{color:#B6BBC2}
.range-label{font-size:32rpx;font-weight:700;color:#1A1D21}
.tilde{color:#8B9199;margin:0 8rpx}
.metrics{display:flex;flex-wrap:wrap;padding:8rpx 0}
.metric{width:50%;margin:16rpx 0}
.metric .muted{font-size:24rpx}
.value{font-size:40rpx;font-weight:700;margin-top:8rpx}
.value.expense{color:#E5484D}
.value.income{color:#17A34A}
.bars{display:flex;align-items:flex-end;gap:6rpx;height:260rpx;padding-top:40rpx}
.bars.dense{gap:2rpx}
.bar-col{flex:1;min-width:0;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%}
.bar-value{font-size:16rpx;color:#8B9199;margin-bottom:6rpx;white-space:nowrap}
.bar-value.hot{color:#E5484D;font-weight:600}
.bar{width:100%;max-width:36rpx;background:#3B82F6;border-radius:8rpx 8rpx 0 0;min-height:4rpx}
.bar.hot{background:#E5484D}
.bar-label{font-size:18rpx;color:#B6BBC2;margin-top:8rpx;white-space:nowrap}
.category-row{margin:28rpx 0}
.cat-name{font-size:30rpx;font-weight:600}
.cat-amount{font-size:30rpx;font-weight:700}
.track{height:12rpx;background:#ECEEF1;border-radius:8rpx;margin-top:14rpx;overflow:hidden}
.fill{height:100%;background:#3B82F6;border-radius:8rpx}
.budget-num{font-size:48rpx;font-weight:800;color:#1A1D21;margin:12rpx 0 8rpx}
.budget-num.over{color:#E5484D}
.budget-hint{color:#3B82F6;font-size:28rpx;padding:8rpx 0}

.cat-name{display:flex;align-items:center;gap:12rpx}
