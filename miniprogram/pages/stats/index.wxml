<view class="container"><view class="title">统计</view><picker mode="date" fields="month" value="{{month}}" bindchange="monthChange"><view class="section">{{month}}　⌄</view></picker><view wx:if="{{error}}" class="error" bindtap="load">{{error}}（点击重试）</view>
 <view class="card"><view class="section">收支概览</view><view class="metrics"><view><view class="muted">支出</view><view class="metric expense">¥{{summary.expense || '0.00'}}</view></view><view><view class="muted">收入</view><view class="metric income">¥{{summary.income || '0.00'}}</view></view></view><view class="muted">结余　¥{{summary.balance || '0.00'}}</view></view>
 <view class="card"><view class="section">每日支出</view><view wx:if="{{!days.length}}" class="empty">暂无数据</view><view wx:for="{{days}}" wx:key="date" class="trend"><view class="row"><text class="muted">{{item.date}}</text><text>¥{{item.amount}}</text></view><view class="track"><view class="bar" style="width:{{item.width}}%"></view></view></view></view>
 <view class="card"><view class="section">支出分类</view><view wx:if="{{!rows.length}}" class="empty">暂无支出</view><view wx:for="{{rows}}" wx:key="category_id" class="category-row"><view class="row"><text>{{item.icon}} {{item.name}}</text><text>¥{{item.amount}}</text></view><view class="row muted"><text>{{item.count}} 笔</text><text>{{item.percent}}%</text></view><view class="track"><view class="bar" style="width:{{item.percent}}%"></view></view></view></view>
</view>
