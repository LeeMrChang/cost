<view class="container">
 <view class="title">分类管理</view><view class="intro">让每一笔收支，都有合适的归属。</view>
 <view class="tabs"><view data-kind="expense" bindtap="changeKind" class="{{kind === 'expense' ? 'tab-active expense' : ''}}">支出分类</view><view data-kind="income" bindtap="changeKind" class="{{kind === 'income' ? 'tab-active income' : ''}}">收入分类</view></view>
 <view wx:if="{{error}}" class="error" bindtap="load">{{error}}（点击重试）</view><view wx:if="{{loading}}" class="empty">正在读取分类…</view>
 <view wx:if="{{!loading}}" class="card list-card"><view wx:for="{{visible}}" wx:key="id" class="list-row {{item.disabled ? 'disabled-row' : ''}}"><view class="list-main" data-id="{{item.id}}" bindtap="edit"><view class="item-icon">{{item.icon}}</view><view><view class="item-name">{{item.name}} <text wx:if="{{item.disabled}}" class="badge">已停用</text></view><view class="muted">排序 {{item.sort_order}}</view></view></view><view wx:if="{{user.role === 'admin'}}" class="actions"><text class="text-link" data-id="{{item.id}}" bindtap="edit">编辑</text><text class="{{item.disabled ? 'income' : 'muted'}}" data-id="{{item.id}}" bindtap="toggle">{{item.disabled ? '启用' : '停用'}}</text></view></view><view wx:if="{{!visible.length}}" class="empty">还没有这类分类</view></view>
 <button wx:if="{{user.role === 'admin'}}" class="button primary-add" disabled="{{loading || saving}}" bindtap="open">＋ 添加{{kind === 'expense' ? '支出' : '收入'}}分类</button>
 <view class="footnote">分类按排序数字从小到大排列。改名会同步显示在历史账单中；停用不会删除历史记录。{{user.role !== 'admin' ? '分类由家庭管理员维护。' : ''}}</view>
</view>
<view wx:if="{{editor}}" class="mask" bindtap="close"><view class="sheet" catchtap="noop"><view class="row"><text bindtap="close">取消</text><text class="section">{{editID ? '编辑' : '添加'}}{{kind === 'expense' ? '支出' : '收入'}}分类</text><text class="sheet-symbol">{{icon}}</text></view>
 <view class="field"><view class="label">分类名称</view><input value="{{name}}" maxlength="50" placeholder="例如：宠物、医疗" data-field="name" bindinput="input"/></view>
 <view class="field"><view class="label">选择图标，也可以输入喜欢的 Emoji</view><view class="icon-grid"><view wx:for="{{icons}}" wx:key="*this" class="icon-choice {{icon === item ? 'icon-active' : ''}}" data-icon="{{item}}" bindtap="pickIcon">{{item}}</view></view><input value="{{icon}}" maxlength="16" data-field="icon" bindinput="input"/></view>
 <view class="field"><view class="label">排序（数字越小越靠前）</view><input type="number" value="{{order}}" maxlength="7" data-field="order" bindinput="input"/></view>
 <button class="button primary-add" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存分类</button>
</view></view>
