:host{display:inline-flex;vertical-align:middle;flex-shrink:0}.category-symbol{display:flex;align-items:center;justify-content:center;box-sizing:border-box;flex-shrink:0;border-radius:50%;background:#FFF0D5;color:#C27A00;line-height:1}.category-symbol.chosen{background:#FFB020;color:#fff;box-shadow:0 0 0 2px #1A1D21}.category-symbol.disabled{opacity:.5;filter:grayscale(1)}.line-glyph{font-family:CostCategoryIcons;font-weight:normal;font-style:normal;line-height:1}
