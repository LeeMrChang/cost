.intro{color:#96969e;font-size:27rpx;margin-top:-12rpx;margin-bottom:32rpx}.tabs{display:flex;background:#e9e9ef;border-radius:20rpx;padding:7rpx;margin-bottom:28rpx}.tabs view{flex:1;text-align:center;padding:18rpx;border-radius:16rpx;color:#96969e}.tabs .tab-active{background:#fff;font-weight:700}.tabs .expense{color:#f3695c}.tabs .income{color:#31bf73}.list-card{padding:0 26rpx}.list-row{display:flex;align-items:center;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #f0f0f4;gap:18rpx}.list-row:last-child{border-bottom:0}.list-main{display:flex;align-items:center;gap:20rpx;flex:1;min-width:0}.item-icon{background:#fff3e9;border-radius:22rpx;min-width:76rpx;height:76rpx;text-align:center;line-height:76rpx;font-size:38rpx}.item-name{font-size:29rpx;font-weight:650;margin-bottom:8rpx;word-break:break-all}.badge{background:#eeeeF3;color:#9999a3;font-size:20rpx;padding:4rpx 10rpx;border-radius:8rpx;white-space:nowrap}.actions{display:flex;gap:20rpx;font-size:24rpx;flex-shrink:0}.text-link{color:#1687ff}.disabled-row .item-icon{filter:grayscale(.6)}.primary-add{margin-top:26rpx;padding:4rpx 0}.footnote{color:#9999a3;font-size:23rpx;line-height:1.8;margin:26rpx 10rpx}.mask{position:fixed;inset:0;background:#0006;display:flex;align-items:flex-end;z-index:10}.sheet{width:100%;box-sizing:border-box;background:#f5f5f7;border-radius:34rpx 34rpx 0 0;padding:24rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));max-height:88vh;overflow-y:auto}.sheet-symbol{font-size:38rpx}.sheet picker{display:block}.sheet .row{gap:20rpx}.sheet .field{padding:24rpx 0}.icon-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12rpx;margin:24rpx 0}.icon-choice{font-size:38rpx;text-align:center;padding:16rpx 0;border-radius:18rpx}.icon-active{background:#fff0de}.subheading{font-size:33rpx;font-weight:700;margin:38rpx 0 24rpx}.money-input{font-size:48rpx;height:78rpx}.load-more{font-size:26rpx;color:#1687ff;background:#eaf3ff;border-radius:18rpx}.end-note{text-align:cent