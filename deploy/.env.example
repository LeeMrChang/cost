# Copy to .env on the SERVER. Use openssl rand -hex 32 for each DB password.
# Do not reuse passwords or copy Mac's existing database / .env.
COST_MYSQL_ROOT_PASSWORD=
COST_MYSQL_PASSWORD=
COST_MIGRATION_PASSWORD=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 生产 HTTPS 主机名，与 miniprogram/utils/config.js 的正式地址一致；不加协议或路径。
COST_DOMAIN=api.xiachen.xyz
# 备案、DNS 和入站 80/443 就绪后，按部署文档显式启动 https profile。
COST_IMAGE_TAG=local

# Optional official Tencent mirror for mainland hosts (same official library images).
# MYSQL_IMAGE=mirror.ccs.tencentyun.com/library/mysql:8.4
# GO_IMAGE=mirror.ccs.tencentyun.com/library/golang:1.27-bookworm
# RUNTIME_IMAGE=mirror.ccs.tencentyun.com/library/debian:bookworm-slim
# GOPROXY=https://goproxy.cn,direct

# Scheduled snapshots and network-isolated restore verification.
# First run starts immediately; failed attempts retry after 300 seconds.
COST_BACKUP_INTERVAL_SECONDS=86400
COST_BACKUP_RETENTION_DAYS=14
COST_BACKUP_VERIFY_INTERVAL_SECONDS=604800
COST_BACKUP_RETRY_SECONDS=300

# Optional reference cache. Leave BOTH blank to disable. Never commit a real password.
# Production internal address: cost-redis:6379 (existing private Redis container).
COST_REDIS_ADDR=
COST_REDIS_PASSWORD=
